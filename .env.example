# ============================================================
# Configuración de TableLive
# ============================================================
# 1. Copiá este archivo y renombralo a ".env" (sin el ".example")
# 2. Completá los valores de abajo con los tuyos
# 3. NUNCA subas el archivo ".env" a GitHub — ya está protegido
#    en el .gitignore, pero prestá atención igual.
# ============================================================

# ---------------- PayPal (comprar monedas y retirar diamantes) ----------------
# Sacás estos dos valores en https://developer.paypal.com/dashboard/applications
# (mirá la guía que te dio Claude para el paso a paso)
#
# IMPORTANTE para que funcione el "Pagar automático" del panel de admin:
# en el dashboard de tu app, en la sección "Features", tenés que activar
# la casilla "Payouts". Si no está activada, el pago automático va a fallar.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Dejalo así (sandbox = modo de pruebas, no cobra plata real) hasta que
# quieras pasar a producción. Para plata real, cambiá a:
# PAYPAL_API_BASE=https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ---------------- Email (para confirmar cuentas nuevas) ----------------
# Si usás Gmail: EMAIL_USER es tu correo, y EMAIL_PASS es una
# "contraseña de aplicación" (no tu contraseña normal de Gmail).
# Se genera en: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# ---------------- Panel de administrador ----------------
# Cambiá esto por una contraseña fuerte tuya, no dejes la de por defecto.
ADMIN_PASSWORD=cambiame123

# El email de esta cuenta entra directo como administrador con acceso total,
# usando SU PROPIA contraseña de TableLive (la que usa para jugar) — no hace falta
# que se acuerde de la contraseña maestra de arriba. Esa persona tiene que estar
# registrada normalmente en TableLive primero.
PLATFORM_ADMIN_EMAIL=

# ---------------- Seguridad de las sesiones ----------------
# Dejalo vacío: el sistema genera una clave segura sola al arrancar.
# Si la ponés vos, tiene que ser un texto largo y aleatorio.
JWT_SECRET=

# ---------------- Puerto del servidor ----------------
PORT=3000

# ---------------- ffmpeg (marca de agua al descargar publicaciones) ----------------
# Si escribís "ffmpeg -version" en tu terminal y funciona, dejá esto vacío.
# Si te dice "no se reconoce" (típico en Windows), poné acá la ruta completa
# hasta ffmpeg.exe, por ejemplo:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
