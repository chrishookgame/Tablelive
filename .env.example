# ============================================================
# Configuración de TableLive
# ============================================================
# 1. Copiá este archivo y renombralo a ".env" (sin el ".example")
# 2. Completá los valores de abajo con los tuyos
# 3. NUNCA subas el archivo ".env" a GitHub — ya está protegido
#    en el .gitignore, pero prestá atención igual.
# ============================================================

# ---------------- PayPal (comprar monedas y retirar diamantes) ----------------
# Sacás estos dos valores en https://developer.paypal.com/dashboard/applications
# (mirá la guía que te dio Claude para el paso a paso)
#
# IMPORTANTE para que funcione el "Pagar automático" del panel de admin:
# en el dashboard de tu app, en la sección "Features", tenés que activar
# la casilla "Payouts". Si no está activada, el pago automático va a fallar.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Dejalo así (sandbox = modo de pruebas, no cobra plata real) hasta que
# quieras pasar a producción. Para plata real, cambiá a:
# PAYPAL_API_BASE=https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ---------------- Email (para confirmar cuentas nuevas, recuperar contraseña, invitaciones) ----------------
# IMPORTANTE: si estás en el plan gratis de Render, Gmail NO va a funcionar — Render
# bloquea los puertos de SMTP en el plan Free desde septiembre de 2025. Por eso hay
# que mandar el email por HTTPS en vez de SMTP. Elegí UNA de estas dos opciones:
#
# OPCIÓN 1 — BREVO (recomendada si no tenés un dominio propio):
# 1. Creá una cuenta gratis en https://www.brevo.com (300 emails por día, gratis)
# 2. Andá a Settings → Senders, agregás tu email de Gmail (u otro) como remitente,
#    y lo verificás con el código de 6 dígitos que te llega — NO hace falta tener
#    un dominio propio para esto, solo tu email de siempre.
# 3. Andá a Settings → SMTP & API → API Keys → Generate a new API key
# 4. Pegá esa clave en BREVO_API_KEY, y el email que verificaste en BREVO_FROM_EMAIL
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=TableLive

# OPCIÓN 2 — RESEND (más simple para probar, pero OJO: con el remitente de prueba
# "onboarding@resend.dev" SOLO te deja mandar a tu propia cuenta de Resend, no a
# usuarios reales — para mandarle a cualquiera hace falta verificar un dominio propio
# en resend.com/domains, algo que Brevo no te pide). Si dejás BREVO_API_KEY vacío,
# se usa esto en su lugar.
RESEND_API_KEY=
RESEND_FROM=TableLive <onboarding@resend.dev>

# Alternativa (solo funciona si NO estás en Render Free, por ejemplo corriendo local
# o en un hosting pago): Gmail por SMTP. Si las dos de arriba están vacías, se usa esto.
# EMAIL_USER es tu correo, y EMAIL_PASS es una "contraseña de aplicación" (no tu
# contraseña normal de Gmail). Se genera en: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# ---------------- Panel de administrador ----------------
# Cambiá esto por una contraseña fuerte tuya, no dejes la de por defecto.
ADMIN_PASSWORD=cambiame123

# El email de esta cuenta entra directo como administrador con acceso total,
# usando SU PROPIA contraseña de TableLive (la que usa para jugar) — no hace falta
# que se acuerde de la contraseña maestra de arriba. Esa persona tiene que estar
# registrada normalmente en TableLive primero.
PLATFORM_ADMIN_EMAIL=

# ---------------- Seguridad de las sesiones ----------------
# Dejalo vacío: el sistema genera una clave segura sola al arrancar.
# Si la ponés vos, tiene que ser un texto largo y aleatorio.
JWT_SECRET=

# ---------------- Puerto del servidor ----------------
PORT=3000

# ---------------- ffmpeg (marca de agua al descargar publicaciones) ----------------
# Si escribís "ffmpeg -version" en tu terminal y funciona, dejá esto vacío.
# Si te dice "no se reconoce" (típico en Windows), poné acá la ruta completa
# hasta ffmpeg.exe, por ejemplo:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
